# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flyrank

# Connection string for running locally outside Docker (points to port 5433 mapped to the host)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/flyrank

# Connection string for running inside Docker Compose (uses container-to-container service name 'db')
DATABASE_URL=postgresql://postgres:postgres@db:5432/flyrank

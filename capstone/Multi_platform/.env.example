# Multi-Platform Social Campaign Publisher Environment Variables (Example)
PORT=8003
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///capstone/Multi_platform/core/multi_platform.db

# Social Platform API Keys / Tokens (Mock / Production)

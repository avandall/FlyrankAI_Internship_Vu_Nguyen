TWITTER_API_SECRET=mock_twitter_api_secret_456
INSTAGRAM_ACCESS_TOKEN=mock_instagram_token_789
LINKEDIN_ACCESS_TOKEN=mock_linkedin_token_abc

# Webhook & Publishing Resilience

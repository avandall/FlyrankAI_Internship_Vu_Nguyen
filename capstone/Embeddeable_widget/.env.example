# Embeddable Widget & Lead Generation Engine Environment Variables (Example)
PORT=8002
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/widget

# Multi-Tenant & Security Config
WIDGET_API_KEY=demo_secret_key_123
WEBHOOK_SECRET_KEY=whsec_widget_secret_999
ALLOWED_DOMAINS=localhost,127.0.0.1,flyrank.ai

# Rate Limiting & Anti-Spam
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=5
ENABLE_HONEYPOT_CHECK=true

# Geo-IP Provider Settings
GEO_IP_PROVIDER_URL=https://ipapi.co

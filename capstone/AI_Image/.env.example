# AI Image Understanding & Content Matching Engine Environment Variables (Example)
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///capstone/AI_Image/core/ai_image.db

# AI Vision & Embeddings Model Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview
OLLAMA_BASE_URL=http://localhost:11434

# Mismatch Guard & Matching Thresholds
CONFIDENCE_THRESHOLD=0.70
SIMILARITY_THRESHOLD=0.60
MAX_BATCH_RETRY=3
